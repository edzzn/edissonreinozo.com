# Google Cloud project with the Text-to-Speech API and billing enabled.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0253492365

# Used by the local audio and cover-image generators. To share one key, its API
# restrictions must allow both Cloud Text-to-Speech and the Gemini API.
# Never expose this variable through a PUBLIC_ prefix or commit your real key.
GOOGLE_CLOUD_TTS_API_KEY=your-restricted-api-key

# Optional alternative: absolute path to a service-account JSON file.
# Omit this when using the API key or globally configured Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-cloud-service-account.json
